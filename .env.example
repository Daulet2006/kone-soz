# Файлды .env деп көшіріп, OpenRouter кілтін толтырыңыз.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Docker Compose ішінде офлайн Kazakh Piper TTS контейнеріне осы мекенжай қолданылады.
TTS_SERVICE_URL=http://tts:8000

# DuckDNS: subdomain ғана жазыңыз, мысалы "tazaqazaqsha".
# Толық сайт мекенжайы: https://tazaqazaqsha.duckdns.org
DOMAIN=kone-soz.duckdns.org
DUCKDNS_SUBDOMAIN=kone-soz
DUCKDNS_TOKEN=

# Қажет болса API сұрауларының минуттық шегін жазыңыз.
API_RATE_LIMIT_PER_MINUTE=12
